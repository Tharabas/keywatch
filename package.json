{
  "name": "keywatch",
  "version": "2.0.0",
  "description": "A browser library for watching/listening to keyboard events",
  "type": "module",
  "main": "dist/esm.js",
  "module": "dist/esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm.js",
      "default": "./dist/esm.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.esm.js",
      "default": "./dist/vue.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "vue.js"
  ],
  "scripts": {
    "test": "vitest run && npm run types:check",
    "types": "tsc -p tsconfig.types.json",
    "types:check": "npm run types && tsc --noEmit -p tsconfig.typecheck.json",
    "dist": "rollup --config && npm run types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tharabas/keywatch.git"
  },
  "keywords": [
    "keyboard",
    "key",
    "hotkey",
    "event",
    "listen",
    "listener",
    "watcher",
    "keycodes",
    "shortcuts",
    "vue"
  ],
  "author": "Ben Schüttler <ben@tharabas.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tharabas/keywatch/issues"
  },
  "homepage": "https://github.com/tharabas/keywatch#readme",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "rollup": "^2.39.0",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
